# WireGuard Server Configuration
#
# This server acts as the secure VPN entry point into the platform.
#
# Routing Model:
#
#   Client Laptop
#       ↓
#   WireGuard VPN Tunnel
#       ↓
#   WireGuard EC2 (Dedicated VPC)
#       ↓
#   AWS Transit Gateway
#       ↓
#   Dev / Prod VPCs
#
# Transit Gateway route tables enforce:
#
#   WireGuard → Dev   : allowed
#   WireGuard → Prod  : allowed
#   Dev ↔ Prod        : blocked
#

[Interface]

# Internal VPN subnet used for connected clients.
Address = 10.8.0.1/24

# UDP port exposed publicly by the WireGuard EC2 security group.
ListenPort = 51820

# Server private key generated during provisioning.
PrivateKey = {{ server_private_key_raw.content | b64decode }}

# PostUp Rules
#
# 1. Allow forwarding into the VPN tunnel.
# 2. Allow forwarding out of the VPN tunnel.
# 3. NAT VPN client traffic through the EC2 instance interface.
#
# VPN clients route RFC1918 platform traffic through this server:
#
#   10.0.0.0/8
#
# Which includes:
#   prod       → 10.0.0.0/16
#   dev        → 10.1.0.0/16
#   wireguard  → 10.2.0.0/16
#

PostUp = iptables -A FORWARD -i %i -j ACCEPT
PostUp = iptables -A FORWARD -o %i -j ACCEPT
PostUp = iptables -t nat -A POSTROUTING -s 10.8.0.0/24 -o {{ default_interface.stdout }} -j MASQUERADE

# Cleanup rules when the interface stops.

PostDown = iptables -D FORWARD -i %i -j ACCEPT
PostDown = iptables -D FORWARD -o %i -j ACCEPT
PostDown = iptables -t nat -D POSTROUTING -s 10.8.0.0/24 -o {{ default_interface.stdout }} -j MASQUERADE

# VPN Clients
#
# Each client receives:
#   - a unique key pair
#   - a static VPN IP
#   - routed access into platform RFC1918 networks

{% for client in clients %}
[Peer]

# Client public key
PublicKey = {{ client_public_keys_raw.results[loop.index0].content | b64decode }}

# Static VPN IP for this client
AllowedIPs = {{ client_ip_map[client] }}/32

{% endfor %}